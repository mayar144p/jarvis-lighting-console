# Copy to wrangler.toml, then: npx wrangler deploy   (see README.md)
name = "haze-report-relay"
main = "worker.mjs"
compatibility_date = "2026-09-01"

[vars]
# the repo the issues go to (GitHub follows a rename, so the current name keeps working)
REPO = "mayar144p/jarvis-lighting-console"

[[r2_buckets]]
binding = "REPORTS"
bucket_name = "haze-reports"
