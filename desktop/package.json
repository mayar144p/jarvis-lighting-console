{
  "name": "haze-desk",
  "productName": "Haze",
  "version": "0.1.0",
  "private": true,
  "description": "Haze lighting desk as a desktop app: the engine runs hidden, the desk opens in its own windows.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "stage": "node stage.mjs",
    "dist": "node stage.mjs && electron-builder"
  },
  "devDependencies": {
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.haze.desk",
    "productName": "Haze",
    "directories": {
      "output": "dist",
      "buildResources": "res"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "res/icon.png"
    ],
    "extraResources": [
      {
        "from": "build/engine",
        "to": "engine"
      },
      {
        "from": "build/python",
        "to": "python"
      },
      {
        "from": "build/llama",
        "to": "llama"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Haze",
      "include": "res/installer.nsh"
    },
    "linux": {
      "target": "dir"
    },
    "publish": null,
    "icon": "res/icon.png",
    "mac": {
      "target": "dmg",
      "identity": null,
      "category": "public.app-category.entertainment",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Haze listens to the music (a microphone or line input) to follow the beat and the drops. Nothing is recorded or sent anywhere."
      }
    }
  },
  "dependencies": {
    "koffi": "3.3.2"
  }
}
