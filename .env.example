# ---- Jarvis configuration -------------------------------------------
# Copy this file to .env and edit. Changes take effect on restart.

APP_NAME=JARVIS
APP_SUBTITLE=Lighting Console
APP_LOGO=dog.svg
PORT=8787
# run.bat / run.sh fetch the latest version on launch (fast-forward only;
# skipped offline or when Jarvis's own files have local edits).
AUTO_UPDATE=true

# ---- AI brain --------------------------------------------------------
# Verified setup: Gemini free tier via Google AI Studio (key starts with AQ.)
# on the OpenAI-compatible endpoint - chat, tool calls and vision all tested.
# Get a key: https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash-lite
# Any other OpenAI-compatible API works too: OpenAI, OpenRouter, Groq,
# local Ollama/LM Studio - change BASE_URL + MODEL (must support tools AND
# images). Leave LLM_API_KEY empty to run in offline mode.

# ---- Output (Art-Net / sACN) -----------------------------------------
# The app IS the lighting desk: it patches, programs and puts the show on
# the wire itself. There is no external console to drive.
# Wire protocol: artnet (6454) or sacn (E1.31, 5568).
DMX_TRANSPORT=artnet
# true  = frames are built and counted but never reach the network
# false = frames can go out (still needs GO LIVE in the console window,
#         and the gate is session-only: a restart comes back dry)
CONSOLE_DRY_RUN=true
# Leave empty for the automatic destination: Art-Net goes to the directed
# broadcast of your lighting subnet (e.g. 192.168.1.255), sACN to each
# universe's multicast group.  Or set the unicast IP of your node.
DMX_HOST=
DMX_PORT=6454
# Frame rate, 10-120 (40 Hz = 25 ms, the Art-Net norm).
DMX_HZ=40
# Art-Net Net 0-127; patch universes 1..256 sit inside Net 0.
DMX_NET=0
# Art-Net: ArtSync after each frame so several universes change together
# (never sent to a broadcast address).
DMX_SYNC=true
# sACN: E1.31 synchronisation universe 1-63999; 0 = off.
SACN_SYNC_UNIVERSE=0
# true = send blackout frames when the app shuts down,
# false = the rig holds its last frame.
DMX_BLACKOUT_ON_EXIT=false
# Where console show files (save/load) are stored.
CONSOLE_SHOW_DIR=data/shows
# Other computers (the whole desk from another laptop, nearby or - with
# Tailscale - in another country), phones and tablets, when started with
# run.bat: HOST=0.0.0.0 answers the network, and CONSOLE_TOKEN below is
# then the code they type once.  (The desktop app does this from Desk ->
# Other computers, phones and tablets.)  Windows asks to let Python through
# its firewall: allow it.
# HOST=0.0.0.0
# Access token for /api/console, which can put real DMX on a wire.
# Not needed while HOST=127.0.0.1 (loopback only).  REQUIRED as soon as
# HOST is anything else - the server then refuses /api/console without
# one.  The console window asks for it and remembers it.
CONSOLE_TOKEN=
# Bug reports without a GitHub account: the address of the report relay
# (tools/report-relay/README.md).  Set, the report window has "Send report".
REPORT_RELAY=
# Only if the relay was set up with a RELAY_KEY.
REPORT_RELAY_KEY=
